<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yuhaodoong.undertow.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/yhdong/Trading/scripts/daily_update.sh</string>
    </array>
    <!-- 2026-10-06 改为每 15 分钟轮询，脚本自己按美东时间判窗口（ET 1:00–8:59）与末班车（ET 08:45 起）。
         原因：原日历时点 18:00/19:00/20:00/20:45 被 launchd 按悉尼时区解读（系统时区是新加坡），
         实际在本地 16:00/17:00/18:00/18:45 触发；10/4 悉尼进夏令时后再提前 1 小时，末班落在 ET 05:45。
         CBOE 的 OI 要到 ET 04:09~06:45 才刷新（周一更晚）→ 10/5 SLV/USO/TQQQ/IWM 缺链，
         且脚本按「本地 20:45」识别末班车，永远不触发告警。轮询与时区无关（AGENTS：需要「窗口内至少跑一次」用 StartInterval）。
         脚本幂等：全部品种已有当日快照 → 立即跳过；OI 未结算 → 不落盘不出报告。 -->
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/yhdong/Library/Logs/undertow-daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yhdong/Library/Logs/undertow-daily.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/yhdong/Trading</string>
</dict>
</plist>
