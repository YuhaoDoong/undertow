<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.yuhaodoong.undertow.spreadlog</string>
  <key>ProgramArguments</key>
  <array><string>/Users/yhdong/Trading/scripts/spread_log.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/yhdong/Trading</string>
  <!-- 每 5 分钟唤醒；脚本自己判断是否落在 ET 09:30–11:00 窗口，不在则静默退出 -->
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>/Users/yhdong/Trading/data/history/spreads/log.out</string>
  <key>StandardErrorPath</key><string>/Users/yhdong/Trading/data/history/spreads/log.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
